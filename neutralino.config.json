{
  "applicationId": "js.neutralino.zero",
  "version": "1.0.0",
  "defaultMode": "window",
  "url": "http://localhost:5173/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "os.*"
  ],
  "modes": {
    "window": {
      "title": "Sextant",
      "width": 800,
      "height": 500,
      "minWidth": 400,
      "minHeight": 200,
      "injectGlobals": true,
      "injectClientLibrary": true
    }
  },
  "cli": {
    "binaryName": "neutralinojs-zero",
    "resourcesPath": "/frontend/static/",
    "extensionsPath": "/extensions/"
  }
}
