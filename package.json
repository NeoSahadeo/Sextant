{
  "name": "Sextant",
  "email": "neosahadeo@protonmail.com",
  "version": "0.0.61",
  "description": "A modified Discord Electron Wrapper to provide a better Discord experience",
  "main": "build/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsc-watch --onSuccess 'bash dev.sh'",
    "dev:vite": "vite",
    "start": "APP_DEV=true electron .",
    "compile": "rm -r build && tsc && tsc-alias",
    "build": "APP_DEV=false pnpm compile && electron-builder",
    "build:dev": "APP_DEV=true && pnpm compile && cp -r static build && electron-builder",
    "build:vite": "vite build",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.sextant.app",
    "productName": "Sextant",
    "directories": {
      "output": "releases"
    },
    "extraResources": [
      {
        "from": "static",
        "to": "static"
      }
    ],
    "files": [
      "src/components",
      "build",
      "static",
      "!**/*.map",
      "!docs"
    ],
    "linux": {
      "category": "Communication",
      "target": [
        "pacman"
      ],
      "maintainer": "Neo Sahadeo <neosahadeo@protonmail.com>"
    },
    "win": {
      "target": "msi",
      "icon": "build/static/sextant.png"
    }
  },
  "keywords": [],
  "author": "Neo Sahadeo",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "tsc-alias": "^1.8.15",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.8.3",
    "@types/node": "^22.15.18"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "toml": "^3.0.0"
  }
}
