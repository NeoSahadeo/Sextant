{
  "name": "Sextant",
  "version": "0.0.1",
  "description": "A modified Discord Electron Wrapper to make Discord a little less of a headache!",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsc-watch --onSuccess 'bash dev.sh'",
    "start": "electron .",
    "build": "tsc && tsc-alias"
  },
  "build": {
    "appId": "com.sextant.app",
    "productName": "Sextant",
    "directories": {
      "output": "releases"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "keywords": [],
  "author": "Neo Sahadeo",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "devDependencies": {
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "toml": "^3.0.0",
    "tsc-alias": "^1.8.15",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "axios": "^1.9.0"
  }
}
