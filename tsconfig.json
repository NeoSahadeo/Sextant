{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ESNext",            // or "ES6", depending on your needs
    "module": "ESNext",            // or "CommonJS" based on your setup
    "moduleResolution": "node",
    "allowJs": true,
    "strict": true,
    "outDir": "dist"
  },
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "include": ["src/**/*"],
  "exclude": ["out"]
}
